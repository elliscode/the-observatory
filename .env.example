# Copy to .env and fill in. `npm start` loads it automatically. Never commit .env.

# Public base URL, used for absolute Open Graph URLs and the admin same-origin check.
PUBLIC_URL=https://observatory.elliscode.com
PORT=3100
# Caddy proxies to localhost, so keep the app off the network directly.
HOST=127.0.0.1
# Reject plain-HTTP API requests (Caddy sets X-Forwarded-Proto: https).
REQUIRE_HTTPS=true

# API keys for consuming applications: comma-separated "<id>:<key>" pairs, one per consumer.
# Each key must be at least 32 characters. Generate one with: openssl rand -base64 32
# Rotation: add the new key, switch the consumer to it, then remove the old one.
# The placeholder below is deliberately too short: the server refuses to start until it is replaced.
OBSERVATORY_API_KEYS=oneshot:CHANGE_ME
# Or a single key (id "default"):
# OBSERVATORY_API_KEY=

# Largest byte count a single /random request may ask for (1-8160).
MAX_RANDOM_BYTES=1024
# Per-key rate limit for /random.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10
# Per-IP limit for /api/v1/health, /api/v1/status and the dashboard.
PUBLIC_RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_BURST=60

# Source administration at /admin. Leave ADMIN_PASSWORD empty to disable admin entirely.
ADMIN_PASSWORD=
# Signs the admin login cookie. Any long random string (openssl rand -hex 32).
SESSION_SECRET=
# true when served over HTTPS (behind Caddy) so the admin cookie is Secure-only.
SECURE_COOKIES=true

# Create a camera source on first start if no sources exist (useful without admin).
OBSERVATORY_SEED_CAMERA=false
OBSERVATORY_CAMERA_DEVICE=0
OBSERVATORY_CAMERA_SUBJECT=Turtle aquarium

# Observations older than this are not mixed into /random output.
ENV_MAX_AGE_MS=600000

# Retention.
OBSERVATION_RETENTION_DAYS=7
REFERENCED_IMAGE_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=30
EVENT_MAX_ROWS=20000
ROUTINE_EVENT_MAX_ROWS=2000
TELEMETRY_RETENTION_DAYS=30

# DATA_DIR=data
# DB_FILE=data/observatory.sqlite
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# LOG_LEVEL=info
